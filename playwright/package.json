{
  "name": "testcase-to-playwright-ts",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "lint": "eslint \"**/*.ts\"",
    "lint:fix": "eslint \"**/*.ts\" --fix",
    "test": "playwright test",
    "test:smoke": "playwright test tests/generated/e2e --grep @smoke --pass-with-no-tests",
    "test:regression:e2e": "playwright test tests/generated/e2e --grep @e2e --pass-with-no-tests",
    "test:regression:visual": "playwright test tests/generated/visual --grep @visual --pass-with-no-tests",
    "test:regression": "npm run test:smoke && npm run test:regression:visual && npm run test:regression:e2e",
    "test:list": "playwright test --list --pass-with-no-tests",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.45.0",
    "@types/node": "^26.0.0",
    "eslint": "^10.8.0",
    "eslint-plugin-playwright": "^2.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0"
  }
}
